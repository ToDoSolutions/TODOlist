    "@mui/x-date-pickers": "^7.18.0",
    "@sentry/react": "^11.0.0",
    "@tanstack/query-sync-storage-persister": "^5.103.2",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-persist-client": "^5.103.2",
    "@tanstack/react-virtual": "^3.14.13",
    "@uiw/react-md-editor": "^4.1.2",
