# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# 0: obligatorio si se usan cookies httpOnly (CORS_ALLOW_CREDENTIALS)
DJANGO_CORS_ALLOW_ALL=0
# URL pública del frontend: CORS, redirects OAuth y enlaces en emails
# (reset/verify usan FRONTEND_URL, que cae a esta si no se define).
DJANGO_FRONTEND_URL=http://localhost:5173
# Opcional: override solo si los enlaces de email deben apuntar a otra URL.
#FRONTEND_URL=

# --- PostgreSQL ---
POSTGRES_DB=todolist
POSTGRES_USER=todolist
POSTGRES_PASSWORD=todolist
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Frontend ---
VITE_API_URL=http://127.0.0.1:8000/api
# Monitorización de errores + Web Vitals (opcional; sin DSN la app funciona igual)
VITE_SENTRY_DSN=

# --- Cifrado de datos (AES-256-GCM, desacoplado de SECRET_KEY) ---
# Lista separada por comas; la ULTIMA es la clave activa para escritura.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
DATA_ENCRYPTION_KEYS=dev-key-1-change-me

# --- Web Push (VAPID) ---
# Par de claves para Web Push API. Generar con:
#   npx web-push generate-vapid-keys
# Sin VAPID_PRIVATE_KEY el envío push queda deshabilitado (no-op) y
# GET /api/push/vapid-key/ responde 404.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUBJECT=mailto:admin@todolist.local

# --- Asistente IA (BYOK, opcional) ---
# Endpoint OpenAI-compatible. Sin AI_LLM_BASE_URL + AI_LLM_MODEL el
# asistente funciona solo con heurísticas deterministas.
# Ejemplos: https://api.openai.com/v1 · http://localhost:11434/v1 (Ollama)
AI_LLM_BASE_URL=
AI_LLM_API_KEY=
AI_LLM_MODEL=

# --- Enterprise: SSO por dominio + provisi�n ---
# OIDC gen�rico (Keycloak/Entra/Okta): registrar el provider en allauth.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_ID=oidc
OIDC_DISPLAY_NAME=SSO

# SAML 2.0 nativo (allauth): metadata del IdP. Activar definiendo
# SAML_IDP_SSO_URL; el cert X509 es obligatorio en producci�n.
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
SAML_IDP_SLO_URL=
SAML_IDP_X509CERT=
SAML_PROVIDER_ID=saml
SAML_DISPLAY_NAME="SAML SSO"

# SCIM 2.0 (/scim/v2): provisi�n de usuarios y grupos (Organizations)
# desde el IdP. Exige SCIM_ENABLED=1 y al menos un bearer token �
# varios separados por coma permiten rotaci�n sin corte.
SCIM_ENABLED=0
SCIM_BEARER_TOKENS=
SCIM_NETLOC=localhost:8000
SCIM_SCHEME=https
