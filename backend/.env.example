# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOW_ALL=0
DJANGO_FRONTEND_URL=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_DB=todolist
POSTGRES_USER=todolist
POSTGRES_PASSWORD=todolist
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Base de datos ---
# 1 para desarrollo/tests locales con SQLite; 0/omitir para PostgreSQL
USE_SQLITE=1

# --- Videoconferencia (Jitsi Meet) ---
# Servidor Jitsi usado para las salas de reuniones (Meeting.video_room).
# Por defecto el servidor público gratuito; para self-hosting apunta a tu
# propia instancia, p.ej. https://jitsi.midominio.com (sin barra final).
JITSI_BASE_URL=https://meet.jit.si


# --- Notificaciones por email ---
# 1 para enviar email (ademas de in-app/push) en asignaciones, menciones y
# recordatorios a usuarios con email_enabled activado en sus preferencias.
# Requiere EMAIL_HOST/EMAIL_HOST_USER/EMAIL_HOST_PASSWORD configurados.
EMAIL_NOTIFICATIONS_ENABLED=0

# --- SSO empresarial (OIDC) ---
# Configurar para habilitar login OIDC (Keycloak/EntraID/Okta/Google Workspace).
# Se registra como provider dinamico y aparece en GET /api/sso/providers/.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_ID=oidc
# OIDC_DISPLAY_NAME=SSO

# --- OAuth social ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
